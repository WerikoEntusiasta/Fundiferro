# ==============================================================================
# FUNDIFERRO FORMAS - VARIÁVEIS DE AMBIENTE & CONFIGURAÇÃO DE E-MAIL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIÇO DE DISPARO DE E-MAILS (SMTP / PROVEDOR DE E-MAIL)
# ------------------------------------------------------------------------------
# Configure os dados do seu servidor SMTP para que as solicitações de orçamento
# e contatos da Fundiferro cheguem diretamente na sua caixa de entrada.

# Host do servidor SMTP (Ex: smtp.gmail.com | smtp.office365.com | smtp.zoho.com | smtp.sendgrid.net | smtp.resend.com)
SMTP_HOST=smtp.gmail.com

# Porta SMTP: 587 (STARTTLS padrão) ou 465 (SSL direto) ou 2525 / 25
SMTP_PORT=587

# Conexão segura SSL: 'false' para porta 587 / 'true' para porta 465
SMTP_SECURE=false

# Usuário / E-mail de autenticação SMTP (Ex: seuemail@gmail.com ou apikey)
SMTP_USER=seu-email-ou-usuario@gmail.com

# Senha do SMTP ou Senha de Aplicativo (No Gmail/Google Workspace: use Senha de App de 16 letras)
SMTP_PASS=sua-senha-ou-app-password

# Nome e E-mail do remetente que aparecerá no cabeçalho da mensagem
EMAIL_FROM="Fundiferro Formas <no-reply@fundiferro.com.br>"

# E-mail(s) de destino que receberão todas as novas propostas e orçamentos de obras
# (Pode separar múltiplos e-mails por vírgula: comercial@fundiferro.com.br, engenharia@fundiferro.com.br)
EMAIL_TO=werikplaystore@gmail.com

# ------------------------------------------------------------------------------
# 2. ALTERNATIVA DIRETA: RESEND API (OPCIONAL)
# ------------------------------------------------------------------------------
# Se preferir usar o serviço moderno Resend via API em vez de SMTP tradicional:
# RESEND_API_KEY=re_123456789abcdef

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES DA PLATAFORMA (GERENCIADAS PELO AI STUDIO)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
